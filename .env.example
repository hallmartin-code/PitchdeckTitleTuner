# Copy this file to .env and fill in your values. Never commit .env.

# --- Required for analysis --------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Model ID (must be vision-capable for image-based slides). Not hard-coded in the app.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Optional model tuning ---------------------------------------------------
# Effort: low | medium | high | xhigh | max | default (omit the parameter)
ANTHROPIC_EFFORT=high
# Thinking: adaptive | off   (use "off" for older models that do not support adaptive thinking)
ANTHROPIC_THINKING=adaptive
# Server-side refusal fallbacks: default | off  (use "off" if your model or platform rejects them)
ANTHROPIC_FALLBACKS=default

# --- Limits ------------------------------------------------------------------
MAX_FILE_MB=50
MAX_SLIDES=80
ANALYSIS_BATCH_SIZE=8
VALIDATION_RETRIES=2
REQUEST_TIMEOUT_SECONDS=600
MAX_DECK_TEXT_CHARS=400000

# --- Conversion --------------------------------------------------------------
# Full path to soffice if LibreOffice is not on PATH or in the default location, e.g.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
CONVERSION_TIMEOUT_SECONDS=180

# --- OCR (optional; OCR fallback is on by default when Tesseract is found) ---
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANGUAGE=eng

# --- Automated results email (Resend) ------------------------------------------
# After every analysis, results (one-page PDF, HTML full review, JSON) are emailed automatically.
# Off when RESEND_API_KEY is empty. Key: https://resend.com/api-keys (sending access).
RESEND_API_KEY=
NOTIFY_TO=Info@tencapital.group
# Sender domain must be verified in Resend.
NOTIFY_FROM=TEN Capital Headline Tuner <reports@tencapital.group>
# NOTIFY_REPLY_TO=
# NOTIFY_SUBJECT_PREFIX=[TEN Capital]
# NOTIFY_ENABLED=true
# Link to the app in the email (defaults to the Railway public domain when deployed)
# APP_PUBLIC_URL=

# --- PDF ---------------------------------------------------------------------
# Optional custom report template (default: templates/headline_review_template.json)
# REPORT_TEMPLATE_PATH=templates/my_template.json
# Optional "Prepared by" line in the PDF footer
# REVIEW_PREPARED_BY=Your Organisation
